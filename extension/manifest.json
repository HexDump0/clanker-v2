{
  "manifest_version": 3,
  "name": "Clanker for Shipwrights",
  "version": "0.1.0",
  "description": "See Clanker's judgement, reason and video on Shipwrights certifications, and fill them into your review.",
  "permissions": [
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://ds.shipwrights.dev/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Clanker judgements"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ds.shipwrights.dev/*"
      ],
      "js": [
        "api.js",
        "ui.js",
        "dash.js",
        "content.js",
        "nav.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "clanker@hackclub.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "judgements.html",
        "judgements.js",
        "api.js",
        "ui.js",
        "bridge.js",
        "ui.css",
        "page.css",
        "panel.css",
        "fonts/*"
      ],
      "matches": [
        "https://ds.shipwrights.dev/*"
      ]
    }
  ]
}
