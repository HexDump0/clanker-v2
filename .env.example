# Shipwrights Dashboard session cookie (the `session` JWT from ds.shipwrights.dev).
# Expires ~30 days after login — refresh it from the browser when auth starts failing.
SHIPWRIGHTS_SESSION=

# Optional overrides (defaults shown)
#SHIPWRIGHTS_BASE_URL=https://ds.shipwrights.dev
#SHIPWRIGHTS_WORKPLACE=stardance
#WATCHER_POLL_INTERVAL=30
#WATCHER_STATE_FILE=data/watcher_state.json
#WATCHER_EMIT_BACKLOG=false
