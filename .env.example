# ── Shipwrights Dashboard ────────────────────────────────────────────────────
# Session cookie (the `session` JWT from ds.shipwrights.dev).
# Expires ~30 days after login — refresh from the browser when auth starts failing.
SHIPWRIGHTS_SESSION=
#SHIPWRIGHTS_BASE_URL=https://ds.shipwrights.dev
#SHIPWRIGHTS_WORKPLACE=stardance

# ── AI model ─────────────────────────────────────────────────────────────────
# openrouter (direct) or hackclub (ai.hackclub.com proxy)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
#HACKCLUB_API_KEY=
MODEL_NAME=xiaomi/mimo-v2.5-pro
# Pin OpenRouter routing to specific providers (comma-separated slugs, e.g.
# "alibaba" for Alibaba Cloud Int.). Empty = free routing. openrouter only.
#OPENROUTER_PROVIDER_ONLY=alibaba
#OPENROUTER_ALLOW_FALLBACKS=false
#REASONING_EFFORT=medium
# Separate one-shot vision model for review-video direction
#VIDEO_DIRECTOR_MODEL_NAME=qwen/qwen3-vl-8b-thinking
# Director routing is independent from OPENROUTER_PROVIDER_ONLY above. Set this
# when the director model is available from a specific provider only.
#VIDEO_DIRECTOR_PROVIDER_ONLY=nex-agi
#VIDEO_DIRECTOR_ALLOW_FALLBACKS=false
#VIDEO_ENABLED=true
#VIDEO_DIR=data/videos
#VIDEO_WORK_DIR=data/video-runs
#VIDEO_TIMEOUT=240
# Background music mixed into review videos (a bundled chill track is used by default)
#VIDEO_MUSIC_ENABLED=true
#VIDEO_MUSIC_FILE=/path/to/your/track.mp3

# ── Reviews ──────────────────────────────────────────────────────────────────
# Optional: raises GitHub API rate limits for the review tools
#GITHUB_TOKEN=
#MAX_CONCURRENT_REVIEWS=2
#PDF_DIR=data/pdfs

# ── Watcher ──────────────────────────────────────────────────────────────────
#WATCHER_POLL_INTERVAL=30
#WATCHER_STATE_FILE=data/watcher_state.json
#WATCHER_EMIT_BACKLOG=false

# ── Slack ────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
# Usergroup (S…) or user (U…) id to cc on new-ship announcements; empty = no cc line
#SLACK_SHIP_PING=
# App-level token: enables the @mention chat bot (Socket Mode); optional
#SLACK_APP_TOKEN=

# ── Observability (optional) ─────────────────────────────────────────────────
#LOGFIRE_TOKEN=
#LOGFIRE_SERVICE_NAME=clanker
