# ── Shipwrights Dashboard ────────────────────────────────────────────────────
# Session cookie (the `session` JWT from ds.shipwrights.dev).
# Expires ~30 days after login — refresh from the browser when auth starts failing.
SHIPWRIGHTS_SESSION=
#SHIPWRIGHTS_BASE_URL=https://ds.shipwrights.dev
#SHIPWRIGHTS_WORKPLACE=stardance

# ── AI model ─────────────────────────────────────────────────────────────────
# openrouter (direct) or hackclub (ai.hackclub.com proxy)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
#HACKCLUB_API_KEY=
MODEL_NAME=deepseek/deepseek-v4-flash-0731
# Dynamic provider routing: prefer the fastest currently healthy endpoint,
# softly prefer p50 latency <= 2s, and reject routes above the price caps.
# Values are USD per million tokens. Works through direct OpenRouter and the
# Hack Club AI proxy. Leave OPENROUTER_PROVIDER_ONLY empty for dynamic routing.
#PROVIDER_SORT=throughput
#PROVIDER_PREFERRED_MAX_LATENCY=2
#PROVIDER_MAX_PROMPT_PRICE=0.5
#PROVIDER_MAX_COMPLETION_PRICE=1.0
# Optional escape hatch to pin specific provider slugs. Empty (recommended) uses
# dynamic routing. Supported through direct OpenRouter and Hack Club AI.
#OPENROUTER_PROVIDER_ONLY=alibaba
#OPENROUTER_ALLOW_FALLBACKS=true
#REASONING_EFFORT=medium
# Vision describer used even when video generation is disabled
#VISION_MODEL_NAME=qwen/qwen3.8-flash
# Separate one-shot vision model for review-video direction
#VIDEO_DIRECTOR_MODEL_NAME=qwen/qwen3-vl-8b-thinking
# Director routing is independent from OPENROUTER_PROVIDER_ONLY above. Leave
# empty for the same dynamic policy, or set only as an explicit escape hatch.
#VIDEO_DIRECTOR_PROVIDER_ONLY=nex-agi
#VIDEO_DIRECTOR_ALLOW_FALLBACKS=false
#VIDEO_ENABLED=true
#VIDEO_DIR=data/videos
#VIDEO_WORK_DIR=data/video-runs
#VIDEO_TIMEOUT=240
# Background music mixed into review videos (a bundled chill track is used by default)
#VIDEO_MUSIC_ENABLED=true
#VIDEO_MUSIC_FILE=/path/to/your/track.mp3

# ── Reviews ──────────────────────────────────────────────────────────────────
# Optional: raises GitHub API rate limits for the review tools
#GITHUB_TOKEN=
#MAX_CONCURRENT_REVIEWS=2
#PDF_DIR=data/pdfs

# ── Watcher ──────────────────────────────────────────────────────────────────
#WATCHER_POLL_INTERVAL=30
#WATCHER_STATE_FILE=data/watcher_state.json
#WATCHER_EMIT_BACKLOG=false

# ── Slack ────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
# Usergroup (S…) or user (U…) id to cc on new-ship announcements; empty = no cc line
#SLACK_SHIP_PING=
# App-level token: enables the @mention chat bot (Socket Mode); optional
#SLACK_APP_TOKEN=

# ── Observability (optional) ─────────────────────────────────────────────────
#LOGFIRE_TOKEN=
#LOGFIRE_SERVICE_NAME=clanker
