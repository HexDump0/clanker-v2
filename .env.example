# ── Shipwrights Dashboard ────────────────────────────────────────────────────
# Session cookie (the `session` JWT from ds.shipwrights.dev).
# Expires ~30 days after login — refresh from the browser when auth starts failing.
SHIPWRIGHTS_SESSION=
#SHIPWRIGHTS_BASE_URL=https://ds.shipwrights.dev
#SHIPWRIGHTS_WORKPLACE=stardance

# ── AI model ─────────────────────────────────────────────────────────────────
# openrouter (direct) or hackclub (ai.hackclub.com proxy)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
#HACKCLUB_API_KEY=
MODEL_NAME=xiaomi/mimo-v2.5-pro
# Pin OpenRouter routing to specific providers (comma-separated slugs, e.g.
# "alibaba" for Alibaba Cloud Int.). Empty = free routing. openrouter only.
#OPENROUTER_PROVIDER_ONLY=alibaba
#OPENROUTER_ALLOW_FALLBACKS=false
#REASONING_EFFORT=medium

# ── Reviews ──────────────────────────────────────────────────────────────────
# Optional: raises GitHub API rate limits for the review tools
#GITHUB_TOKEN=
#MAX_CONCURRENT_REVIEWS=2
#PDF_DIR=data/pdfs

# ── Watcher ──────────────────────────────────────────────────────────────────
#WATCHER_POLL_INTERVAL=30
#WATCHER_STATE_FILE=data/watcher_state.json
#WATCHER_EMIT_BACKLOG=false

# ── Slack ────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
# App-level token: enables the @mention chat bot (Socket Mode); optional
#SLACK_APP_TOKEN=

# ── Observability (optional) ─────────────────────────────────────────────────
#LOGFIRE_TOKEN=
#LOGFIRE_SERVICE_NAME=clanker
